---
import type { MetaTags } from '../lib/seo/meta';
import { loadBusiness } from '../lib/content/loaders';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  meta: MetaTags;
  schema?: any[];
}

const { meta, schema = [] } = Astro.props;
const business = loadBusiness();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{meta.title}</title>
  <meta name="description" content={meta.description}>
  <link rel="canonical" href={meta.canonical}>
  
  <meta property="og:title" content={meta.ogTitle || meta.title}>
  <meta property="og:description" content={meta.ogDescription || meta.description}>
  <meta property="og:image" content={meta.ogImage}>
  <meta property="og:type" content={meta.ogType || 'website'}>
  <meta property="og:url" content={meta.canonical}>
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={meta.ogTitle || meta.title}>
  <meta name="twitter:description" content={meta.ogDescription || meta.description}>
  <meta name="twitter:image" content={meta.ogImage}>
  
  {schema.map(s => s && (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header business={business} />
  
  <main>
    <slot />
  </main>
  
  <Footer business={business} />
</body>
</html>

<style is:global>
  :root {
    --header-offset: 160px;
    --page-pad-x: 2rem;
    --page-pad-b: 3rem;
  }
  
  @media (max-width: 768px) {
    :root {
      --header-offset: 120px;
      --page-pad-x: 1.5rem;
      --page-pad-b: 2rem;
    }
  }
  
  * {
    box-sizing: border-box;
  }
  
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: #333;
    background: white;
  }
  
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--header-offset) var(--page-pad-x) var(--page-pad-b);
    min-height: calc(100vh - 400px);
  }
  
  img {
    max-width: 100%;
    height: auto;
  }
  
  a {
    color: inherit;
  }
</style>
