---
interface MediaImage {
  id: string;
  filename: string;
  category: string;
  description: string;
}

interface Props {
  images: MediaImage[];
  serviceName: string;
  cityName?: string;
  altTextGenerator: (serviceName: string, description: string, cityName?: string) => string;
}

const { images, serviceName, cityName, altTextGenerator } = Astro.props;
---

{images.length > 0 && (
  <div class="service-gallery">
    <h3>{serviceName} Work Examples</h3>
    <div class="gallery-grid">
      {images.map(image => (
        <div class="gallery-item">
          <img 
            src={`/images/services/${image.filename}`} 
            alt={altTextGenerator(serviceName, image.description, cityName)}
            loading="lazy"
            width="400"
            height="300"
          />
          <div class="gallery-caption">
            <p>{image.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<style>
  .service-gallery {
    margin: 3rem 0;
    padding: 2rem;
    background: #f9f9f9;
    border-radius: 8px;
  }
  
  .service-gallery h3 {
    color: #1a1a1a;
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    text-align: center;
  }
  
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }
  
  .gallery-item {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s, box-shadow 0.3s;
  }
  
  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }
  
  .gallery-item img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
  }
  
  .gallery-caption {
    padding: 1rem;
  }
  
  .gallery-caption p {
    margin: 0;
    color: #555;
    font-size: 0.9rem;
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
    
    .service-gallery {
      padding: 1.5rem;
    }
  }
</style>
