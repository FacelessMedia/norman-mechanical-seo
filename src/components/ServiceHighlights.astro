---
const services = [
  {
    name: 'Plumbing',
    icon: '/images/icons/drain.png',
    link: '/services/commercial-plumbing'
  },
  {
    name: 'Water Line',
    icon: '/images/icons/water-line.png',
    link: '/services/water-line-repair-and-replacement'
  },
  {
    name: 'Water Heater',
    icon: '/images/icons/water-heater.png',
    link: '/services/water-heaters'
  },
  {
    name: 'Sewer',
    icon: '/images/icons/sewer.png',
    link: '/services/sewer-line-repair-and-replacement'
  }
];
---

<section class="service-highlights">
  <div class="container">
    <h2>Top-Rated Plumbers Servicing Chicagoland</h2>
    <p class="intro">
      Norman Mechanical, Inc. is a fully licensed, bonded, and insured plumbing and sewer contractor proudly serving the Chicagoland area since 1988. There is no work that is too big nor too small. We are a plumbing company equipped to meet the needs of homes, businesses, and municipalities across the region. Each of our licensed plumbers on our service team has over 10,000 hours of training. We provide dependable, 24/7 plumbing and sewer services backed by advanced technology, and licensed, highly skilled and experienced professionals with a strong commitment to extraordinary service and workmanship.
    </p>
    
    <div class="services-grid">
      {services.map((service) => (
        <a href={service.link} class="service-card">
          <img src={service.icon} alt="" width="142" height="139" loading="lazy" />
          <h3>{service.name}</h3>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .service-highlights {
    padding: 4rem 2rem;
    background: white;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    text-align: center;
    margin: 0 0 1.5rem;
    color: #1a1a1a;
  }
  
  .intro {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #333;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }
  
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem;
    background: #f8f9fa;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s;
    border: 2px solid transparent;
  }
  
  .service-card:hover {
    background: white;
    border-color: #269041;
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
  }
  
  .service-card img {
    width: 100px;
    height: 100px;
    object-fit: contain;
    margin-bottom: 1rem;
  }
  
  .service-card h3 {
    margin: 0;
    font-size: 1.5rem;
    color: #269041;
    text-transform: uppercase;
    font-weight: 700;
  }
  
  @media (max-width: 768px) {
    .service-highlights {
      padding: 3rem 1.5rem;
    }
    
    .services-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }
  }
</style>
