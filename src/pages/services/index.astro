---
import Base from '../../layouts/Base.astro';
import { loadBusiness, loadAllServices } from '../../lib/content/loaders';
import { generateMetaTags, buildTitle } from '../../lib/seo/meta';
import { generateBreadcrumbSchema, buildBreadcrumbs } from '../../lib/content/schema/breadcrumbs';
import { getServiceLinks } from '../../lib/content/internalLinks';

const business = loadBusiness();
const allServices = loadAllServices();

const baseUrl = business.url;
const pageUrl = `${baseUrl}/services`;

const meta = generateMetaTags(
  buildTitle(['Services'], business.name),
  `Professional plumbing services including ${allServices.slice(0, 3).map(s => s.name.toLowerCase()).join(', ')} and more`,
  '/services',
  baseUrl
);

const breadcrumbs = buildBreadcrumbs('/services', 'Services');
const schema = [
  generateBreadcrumbSchema(breadcrumbs, baseUrl)
];

const serviceLinks = getServiceLinks(allServices);
---

<Base meta={meta} schema={schema}>
  <h1>Our Services</h1>
  <p class="lead">Comprehensive plumbing and mechanical services for residential and commercial properties</p>
  
  <div class="services-grid">
    {allServices.map(service => (
      <article class="service-card">
        <h2><a href={`/services/${service.slug}`}>{service.name}</a></h2>
        <p>{service.description}</p>
        <a href={`/services/${service.slug}`} class="cta">Learn More →</a>
      </article>
    ))}
  </div>
</Base>

<style>
  .lead {
    font-size: 1.25rem;
    color: #555;
    margin-bottom: 2rem;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  
  .service-card {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 1.5rem;
    background: white;
  }
  
  .service-card h2 {
    margin-top: 0;
    font-size: 1.5rem;
  }
  
  .service-card h2 a {
    color: #1a1a1a;
    text-decoration: none;
  }
  
  .service-card h2 a:hover {
    color: #0066cc;
  }
  
  .service-card p {
    color: #666;
    line-height: 1.6;
  }
  
  .cta {
    display: inline-block;
    margin-top: 1rem;
    color: #0066cc;
    text-decoration: none;
    font-weight: 500;
  }
  
  .cta:hover {
    text-decoration: underline;
  }
</style>
