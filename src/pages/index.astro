---
import { loadBusiness, loadGBP } from '../lib/content/loaders';
import { generateLocalBusinessSchema } from '../lib/content/schema/localBusiness';
import { generateMetaTags, buildTitle } from '../lib/seo/meta';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ServiceHighlights from '../components/ServiceHighlights.astro';
import AboutSection from '../components/AboutSection.astro';
import Testimonials from '../components/Testimonials.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Footer from '../components/Footer.astro';

const business = loadBusiness();
const gbp = loadGBP();
const baseUrl = business.url;
const pageUrl = baseUrl;

const meta = generateMetaTags(
  buildTitle([], business.name),
  business.description,
  '/',
  baseUrl,
  business.image
);

const schema = [
  generateLocalBusinessSchema(business, gbp, pageUrl)
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{meta.title}</title>
  <meta name="description" content={meta.description}>
  <link rel="canonical" href={meta.canonical}>
  
  <meta property="og:title" content={meta.ogTitle || meta.title}>
  <meta property="og:description" content={meta.ogDescription || meta.description}>
  <meta property="og:image" content={meta.ogImage}>
  <meta property="og:type" content={meta.ogType || 'website'}>
  <meta property="og:url" content={meta.canonical}>
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={meta.ogTitle || meta.title}>
  <meta name="twitter:description" content={meta.ogDescription || meta.description}>
  <meta name="twitter:image" content={meta.ogImage}>
  
  {schema.map(s => s && (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <Header business={business} />
  
  <main>
    <Hero business={business} />
    <ServiceHighlights />
    <AboutSection />
    <Testimonials />
    <MapEmbed business={business} />
  </main>
  
  <Footer business={business} />
</body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    line-height: 1.6;
    color: #333;
    background: white;
  }
  
  main {
    min-height: 100vh;
  }
  
  img {
    max-width: 100%;
    height: auto;
  }
  
  a {
    color: inherit;
  }
</style>
