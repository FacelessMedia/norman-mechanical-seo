---
import Base from '../layouts/Base.astro';
import { loadBusiness, loadGBP } from '../lib/content/loaders';
import { generateLocalBusinessSchema } from '../lib/content/schema/localBusiness';
import { generateMetaTags, buildTitle } from '../lib/seo/meta';
import Hero from '../components/Hero.astro';
import ServiceHighlights from '../components/ServiceHighlights.astro';
import AboutSection from '../components/AboutSection.astro';
import Testimonials from '../components/Testimonials.astro';
import MapEmbed from '../components/MapEmbed.astro';

const business = loadBusiness();
const gbp = loadGBP();
const baseUrl = business.url;
const pageUrl = baseUrl;

const meta = generateMetaTags(
  buildTitle([], business.name),
  business.description,
  '/',
  baseUrl,
  business.image
);

const schema = [
  generateLocalBusinessSchema(business, gbp, pageUrl)
];
---

<Base meta={meta} schema={schema}>
  <Hero business={business} />
  <ServiceHighlights />
  <AboutSection />
  <Testimonials />
  <MapEmbed business={business} />
</Base>

<style>
  :global(main) {
    padding-top: 140px !important;
  }
  
  @media (max-width: 768px) {
    :global(main) {
      padding-top: 100px !important;
    }
  }
</style>
