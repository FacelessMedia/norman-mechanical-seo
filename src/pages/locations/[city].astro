---
import Base from '../../layouts/Base.astro';
import { loadBusiness, loadCity, loadAllCities, loadAllServices } from '../../lib/content/loaders';
import { generateCitySchema, generateAreaServedSchema } from '../../lib/content/schema/city';
import { generateFAQSchema } from '../../lib/content/schema/faq';
import { generateBreadcrumbSchema, buildBreadcrumbs } from '../../lib/content/schema/breadcrumbs';
import { generateMetaTags, buildTitle } from '../../lib/seo/meta';
import { getTopServiceLinks } from '../../lib/content/internalLinks';
import { loadGBP } from '../../lib/content/loaders';
import { shouldShowReviews, shouldShowTrustBadges, shouldShowCTA, getReviewLimit } from '../../lib/content/conversionRules';
import ReviewExcerpts from '../../components/conversion/ReviewExcerpts.astro';
import TrustBadges from '../../components/conversion/TrustBadges.astro';
import LocationCTA from '../../components/conversion/LocationCTA.astro';
import CityGallery from '../../components/media/CityGallery.astro';
import { getCityImages, generateCityImageAlt } from '../../lib/content/mediaRules';

export async function getStaticPaths() {
  const allCities = loadAllCities();
  return allCities
    .filter(city => city.type === 'city')
    .map(city => ({
      params: { city: city.slug },
      props: { city }
    }));
}

const { city } = Astro.props;
const business = loadBusiness();
const gbp = loadGBP();
const allServices = loadAllServices();

const baseUrl = business.url;
const pageUrl = `${baseUrl}/locations/${city.slug}`;

const neighborhoodList = city.neighborhoods?.slice(0, 3).join(', ') || 'the area';

const meta = generateMetaTags(
  buildTitle([`${city.name}, ${city.stateAbbr}`], business.name),
  `${city.description}. Serving ${neighborhoodList} and surrounding areas.`,
  `/locations/${city.slug}`,
  baseUrl
);

const shouldNoindex = city.indexable === false;

const breadcrumbs = buildBreadcrumbs(`/locations/${city.slug}`, city.name);
const cityFaqs = city.city_faqs || city.faqs || [];
const schema = [
  generateCitySchema(city, business, pageUrl),
  generateAreaServedSchema(city, business),
  generateFAQSchema(cityFaqs, pageUrl),
  generateBreadcrumbSchema(breadcrumbs, baseUrl)
].filter(Boolean);

const topServiceLinks = getTopServiceLinks(allServices);

const pageType = 'city';
const showReviews = shouldShowReviews(pageType);
const showTrustBadges = shouldShowTrustBadges(pageType);
const showCTA = shouldShowCTA(pageType);
const reviewLimit = getReviewLimit(pageType);

const cityImages = getCityImages(city.slug, 3);
---

<Base meta={meta} schema={schema}>
  <h1>{business.name} in {city.name}, {city.stateAbbr}</h1>
  <p class="lead">{city.description}</p>
  
  {showTrustBadges && (
    <TrustBadges 
      emergencyService={business.emergency_service} 
      licensed={true} 
      insured={true} 
    />
  )}
  
  <section>
    <h2>Why Choose Us in {city.name}</h2>
    <ul>
      {city.localFactors.map(factor => (
        <li>{factor}</li>
      ))}
    </ul>
  </section>
  
  <section>
    <h2>Neighborhoods We Serve</h2>
    <ul class="neighborhoods-list">
      {city.neighborhoods.map(neighborhood => (
        <li>{neighborhood}</li>
      ))}
    </ul>
  </section>
  
  <section>
    <h2>Our Services in {city.name}</h2>
    <ul class="services-list">
      {topServiceLinks.map(link => (
        <li><a href={`/locations/${city.slug}${link.href.replace('/services', '')}`}>{link.text} in {city.name}</a></li>
      ))}
    </ul>
  </section>
  
  {showCTA && (
    <LocationCTA 
      cityName={city.name} 
      phoneDisplay={business.phone_display} 
      phoneE164={business.phone_e164} 
      emergencyService={business.emergency_service} 
    />
  )}
  
  {showReviews && gbp.featured_review_excerpts && (
    <ReviewExcerpts 
      reviews={gbp.featured_review_excerpts} 
      limit={reviewLimit} 
    />
  )}
  
  <CityGallery 
    images={cityImages} 
    cityName={city.name} 
    altTextGenerator={generateCityImageAlt} 
  />
  
  {city.faqs && city.faqs.length > 0 && (
    <section>
      <h2>Frequently Asked Questions</h2>
      {city.faqs.map(faq => (
        <div class="faq-item">
          <h3>{faq.question}</h3>
          <p>{faq.answer}</p>
        </div>
      ))}
    </section>
  )}
  
  <section>
    <h2>Local Landmarks</h2>
    <ul class="landmarks-list">
      {city.landmarks.map(landmark => (
        <li>{landmark}</li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .lead {
    font-size: 1.25rem;
    color: #555;
    margin-bottom: 2rem;
  }
  
  section {
    margin: 3rem 0;
  }
  
  h2 {
    color: #1a1a1a;
    margin-bottom: 1rem;
    border-bottom: 2px solid #0066cc;
    padding-bottom: 0.5rem;
  }
  
  ul {
    line-height: 1.8;
  }
  
  .neighborhoods-list,
  .landmarks-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }
  
  .services-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }
  
  .services-list a {
    color: #0066cc;
    text-decoration: none;
    padding: 0.5rem;
    display: block;
    background: #f9f9f9;
    border-radius: 4px;
  }
  
  .services-list a:hover {
    background: #e8f4ff;
    text-decoration: underline;
  }
  
  .faq-item {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #f9f9f9;
    border-radius: 8px;
  }
  
  .faq-item h3 {
    margin-top: 0;
    color: #1a1a1a;
  }
  
  .faq-item p {
    margin-bottom: 0;
    color: #555;
  }
</style>
